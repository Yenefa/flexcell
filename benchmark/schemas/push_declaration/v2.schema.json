{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evobot.org/schemas/push-declaration-2.0.json",
  "title": "EvoBot PUSH task declaration v2.0",
  "description": "Versioned push declaration. NEW format only; legacy frozen TaskSpecs are handled by the explicit v1 adapter, never by loosening this contract.",
  "$comment": "Issue #243. v2 aligns with experiment probe.schema.json on develop/physical-capabilities-20261113 (template_id T08_push, push clause, zone_N naming, 0.5.x evaluator) but does NOT pin experimental constants as const, so the contract is reusable across instances. No frozen schema, evaluator, threshold, TaskSpec or evidence is modified.",
  "type": "object",
  "required": [
    "declaration_version",
    "task_id",
    "template_id",
    "random_seed",
    "instruction",
    "objects",
    "zones",
    "expected_goal",
    "evaluator_version",
    "execution_budget",
    "split"
  ],
  "additionalProperties": false,
  "properties": {
    "declaration_version": {
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[a-z0-9_-]+$"
    },
    "template_id": {
      "const": "T08_push"
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "instruction": {
      "type": "string",
      "minLength": 8
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "size",
          "initial_pose"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^target_box_[a-z]$"
          },
          "color": {
            "type": "string"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0.005
            },
            "minItems": 3,
            "maxItems": 3
          },
          "initial_pose": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "pose",
          "radius"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^zone_[0-9]+$"
          },
          "pose": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_move": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "expected_goal": {
      "type": "object",
      "required": [
        "push",
        "unmoved"
      ],
      "additionalProperties": false,
      "properties": {
        "push": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "min_displacement_m",
              "max_displacement_m",
              "max_vertical_m",
              "direction",
              "min_direction_cosine",
              "zone"
            ],
            "additionalProperties": false,
            "properties": {
              "min_displacement_m": {
                "type": "number",
                "minimum": 0
              },
              "max_displacement_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_vertical_m": {
                "type": "number",
                "minimum": 0
              },
              "direction": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "min_direction_cosine": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "zone": {
                "type": "string",
                "pattern": "^zone_[0-9]+$"
              }
            }
          }
        },
        "unmoved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "execution_budget": {
      "type": "object",
      "required": [
        "max_steps",
        "max_wall_s"
      ],
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_s": {
          "type": "number",
          "minimum": 1
        }
      }
    },
    "split": {
      "enum": [
        "train",
        "val",
        "held_out"
      ]
    }
  }
}
