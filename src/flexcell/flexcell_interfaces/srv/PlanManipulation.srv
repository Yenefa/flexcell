# Private planner adapter. This service never executes a trajectory or attaches physics.
# The attached_point service accepts POINT with one target for a legacy stage;
# the mtc service accepts PICK/PLACE with three targets for its stage sequence.
string operation
string object_name
geometry_msgs/PoseStamped object_pose
geometry_msgs/PoseStamped[] targets
# Attached-point POINT uses one box-center target. Joint MTC PLACE uses two
# box-center targets and a third defining world retreat displacement from 2.
# object_pose is a fresh physical sample in both cases.
# False retains the existing three end-effector position targets.
bool attached_object_targets
string motion_profile_id
uint32 deadline_ms
---
bool success
string detail
moveit_msgs/RobotTrajectory[] trajectories
# Measured-model FK at each trajectory endpoint, always end_effector_link.
# The adapter must not hand an object-center target to MoveToPose.
geometry_msgs/PoseStamped[] executor_targets
