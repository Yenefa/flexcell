# Normalize line endings: the runtime is Linux/WSL, so the repo stores LF.
# Why: the Windows-side clone ran core.autocrlf=true with no .gitattributes,
# so every `*.sh` arrived as CRLF and died on `set -euo pipefail\r`
# ("pipefail: invalid option name") - hit for real on 2026-09-29 during the
# new-machine bring-up. `* text=auto` lets git sniff, the explicit list pins the
# files that are actually executed or parsed, and the binary list keeps
# EOL translation away from files it would corrupt.
* text=auto eol=lf

# executed / parsed by the ROS 2 + Python stack
*.sh text eol=lf
*.py text eol=lf
*.bash text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.xml text eol=lf
*.sdf text eol=lf
*.urdf text eol=lf
*.xacro text eol=lf
*.action text eol=lf
*.msg text eol=lf
*.launch text eol=lf
*.txt text eol=lf
*.out text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf

# docs: prettier normalizes these to LF anyway
*.md text eol=lf

# never EOL-translate
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.gz binary
*.tgz binary
*.vcd binary
*.bag binary
*.db3 binary

# Frozen evidence manifests hash exact bytes, including original line endings.
setup/acceptance/** -text
