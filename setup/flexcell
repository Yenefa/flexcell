#!/usr/bin/env bash
# FlexCell workcell lifecycle: start | stop | reset | status | health
#
# Process ownership via setsid process groups + PID files under
# /tmp/flexcell_lifecycle/pids - no pkill -f substring matching. Every start
# ends with a strict health check: any component missing/duplicated/not-ready
# FAILS the start.
set -o pipefail
REPO=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
RUNTIME=${FLEXCELL_WS:-$HOME/agentic_workcell_ws}
LC=/tmp/flexcell_lifecycle
PIDS=$LC/pids
LOGS=$LC/logs
ADMIN=$REPO/setup/flexcell_admin.py
READY=$REPO/setup/117_ros_ready.py
COMPONENTS="gazebo moveit move_to_pose fleet"

export FLEXCELL_WS=$RUNTIME
if [ -z "${FLEXCELL_INSTALL:-}" ] && [ ! -f "$HOME/.local/share/flexcell/mainline/install/setup.bash" ]; then
  export FLEXCELL_INSTALL=$RUNTIME/install
fi
source "$REPO/setup/104_mainline_env.sh" || exit 1
WORLD=${FLEXCELL_WORLD:-$REPO/worlds/flexcell_world}
[ -f "$WORLD.sdf" ] || { echo "WORLD MISSING: $WORLD.sdf" >&2; exit 1; }
cd "$RUNTIME"
mkdir -p "$LOGS"

alive_pids() {
  local n=0
  for f in "$PIDS"/*.pid; do
    [ -f "$f" ] || continue
    if kill -0 "$(cat "$f")" 2>/dev/null; then n=$((n+1)); fi
  done
  echo "$n"
}

gz_models_ready() {
  local out
  out=$(timeout 12 gz model --list 2>/dev/null)
  for m in ground_plane open_manipulator_x target_box_a target_box_b zone_1 zone_2; do
    echo "$out" | grep -q "$m" || return 1
  done
  return 0
}


launch() { # <name> <command...>
  local name="$1"
  shift
  setsid nohup "$@" > "$LOGS/$name.log" 2>&1 < /dev/null &
  echo $! > "$PIDS/$name.pid"
  echo "launched $name (pid $!, pgid $!)"
}

cmd_start() {
  if [ "$(alive_pids)" != "0" ]; then
    echo "START REFUSED: flexcell already running (use: flexcell stop)"; exit 1
  fi
  mkdir -p "$PIDS" "$LOGS"
  # settle: any pre-existing stack instance must be fully gone first (a dying
  # gz server races the new one for transport ports and both lose)
  t=0
  while pgrep -f 'gz si[m]|move_grou[p]|robot_state_publishe[r]' > /dev/null; do
    sleep 2; t=$((t+2))
    if [ $t -ge 20 ]; then
      echo "START REFUSED: pre-existing stack still alive after ${t}s (run: flexcell stop)"; exit 1
    fi
  done
  echo "== flexcell start =="
  launch gazebo ros2 launch open_manipulator_bringup open_manipulator_x_gazebo.launch.py "world:=$WORLD"
  started=$SECONDS
  deadline=$((SECONDS+60))
  while ! gz_models_ready; do
    sleep 2
    if [ $SECONDS -ge $deadline ]; then echo "START FAILED: gz world not ready"; exit 1; fi
  done
  echo "READY: gz world + 6 models ($((SECONDS-started))s)"

  launch moveit ros2 launch open_manipulator_moveit_config open_manipulator_x_moveit.launch.py use_sim:=true start_rviz:=false
  if ! python3 "$READY" controllers --timeout 60; then
    echo "START FAILED: controller service readiness did not pass"; exit 1
  fi
  echo "READY: 3 controllers active"

  launch move_to_pose ros2 launch flexcell_skills move_to_pose.launch.py
  launch fleet bash "$REPO/setup/98_run_policy.sh" "${FLEXCELL_POLICY:-fsm}" "${FLEXCELL_HYBRID_THRESHOLD:-0.7}"
  deadline=$((SECONDS+90))
  until timeout --kill-after=3 30 python3 "$ADMIN" health --no-strict > /dev/null 2>&1; do
    if [ "$SECONDS" -ge "$deadline" ]; then echo "START FAILED: skill fleet not ready"; exit 1; fi
    sleep 2
  done
  echo "READY: skill fleet"

  echo "== strict health check =="
  if python3 "$ADMIN" health; then
    echo "START OK"
  else
    echo "START FAILED: strict health check did not pass (see report above)"
    exit 1
  fi
}

cmd_stop() {
  echo "== flexcell stop =="
  local any=0
  for f in "$PIDS"/*.pid; do
    [ -f "$f" ] || continue
    any=1
    local pid name
    pid=$(cat "$f"); name=$(basename "$f" .pid)
    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
      echo "TERM -> $name (group $pid)"
    fi
  done
  if [ "$any" = "1" ]; then
    sleep 6
    for f in "$PIDS"/*.pid; do
      [ -f "$f" ] || continue
      local pid name
      pid=$(cat "$f"); name=$(basename "$f" .pid)
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
        echo "KILL -> $name (group $pid)"
      fi
    done
  fi
  rm -rf "$PIDS"

  # A fresh rclpy participant checks residual nodes/actions without the ROS CLI.
  if python3 "$READY" stopped --timeout 12; then
    echo "STOP OK: 0 relevant nodes, 0 relevant actions"
  else
    echo "STOP INCOMPLETE (see residue above)"; exit 1
  fi
}

cmd_reset() {
  echo "== flexcell reset =="
  python3 "$ADMIN" reset
}

cmd_status() {
  echo "pid files (alive): $(alive_pids)"
  python3 "$ADMIN" health --no-strict
}

cmd_health() {
  python3 "$ADMIN" health
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  reset) cmd_reset ;;
  status) cmd_status ;;
  health) cmd_health ;;
  *) echo "usage: flexcell start|stop|reset|status|health"; exit 2 ;;
esac
